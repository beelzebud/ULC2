#include <winver.h>

IDI_ICON1 ICON "icons/emu_manager.ico"

// APP_VERSION is supplied by CMake (target_compile_definitions) so the
// executable's Windows properties track the git-tag / CI version. Fall back
// to a placeholder when the resource compiler is invoked without it.
#ifndef APP_VERSION
#define APP_VERSION "dev"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     1,0,0,0
 PRODUCTVERSION  1,0,0,0
 FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Emu-Manager"
            VALUE "FileDescription",  "Emu-Manager"
            VALUE "FileVersion",      APP_VERSION
            VALUE "InternalName",     "Emu-Manager"
            VALUE "LegalCopyright",   "Copyright (C) 2026 John N. Bilbrey"
            VALUE "OriginalFilename", "Emu-Manager.exe"
            VALUE "ProductName",      "Emu-Manager"
            VALUE "ProductVersion",   APP_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
